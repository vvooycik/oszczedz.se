# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings -> API
#
# Both values are safe to expose in the browser bundle — RLS is the security
# boundary, not secrecy of the anon key. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
